rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User data tree: Each authenticated user owns their own leads, outreach, and profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /leads/{leadId} {
        allow read, write: if isOwner(userId) && isValidId(leadId);
      }

      match /outreach/{logId} {
        allow read, write: if isOwner(userId) && isValidId(logId);
      }

      match /profile/{profileId} {
        allow read, write: if isOwner(userId) && isValidId(profileId);
      }
    }

    // Health check collection for connection testing
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
